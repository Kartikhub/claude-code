    {
      "type": "text",
      "id": "memdir_text",
      "x": 51,
      "y": 105.25,
      "width": 290.0390625,
      "height": 192.5,
      "text": "    memdir/ — Permanent Structured Memory\n\n    Storage: MEMORY.md index file\n    Cap: 200 lines max, 25KB\n    Loaded: Every turn (in system prompt)\n    Types: user, feedback, project, reference\n    \n    Exclusions:\n      Architecture, code patterns,\n      implementation details\n      (those belong in source control)\n    \n    Search: Frontmatter-based queries\n    8 files in src/memdir/",
      "originalText": "    memdir/ — Permanent Structured Memory\n\n    Storage: MEMORY.md index file\n    Cap: 200 lines max, 25KB\n    Loaded: Every turn (in system prompt)\n    Types: user, feedback, project, reference\n    \n    Exclusions:\n      Architecture, code patterns,\n      implementation details\n      (those belong in source control)\n    \n    Search: Frontmatter-based queries\n    8 files in src/memdir/",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
