    {
      "type": "text",
      "id": "comparison_text",
      "x": 37.00006103515625,
      "y": 428.1666564941406,
      "width": 728.3203125,
      "height": 110,
      "text": "COMPARISON TABLE\n\n                     Coordinator                     Swarm                           KAIROS\nTopology:            Hub → Spoke                     Peer ↔ Peer                     Main → Background\nLifetime:            Parent turn only                Until task complete              Cross-session persistent\nPermissions:         Inherited + restricted          Shared policy set               Strict least-privilege\nCommunication:       subagent() return value         transfer_to_agent() handoff     Filesystem signals\nBest for:            Decomposing complex tasks       Multi-persona workflows         Long-running autonomous work",
      "originalText": "COMPARISON TABLE\n\n                     Coordinator                     Swarm                           KAIROS\nTopology:            Hub → Spoke                     Peer ↔ Peer                     Main → Background\nLifetime:            Parent turn only                Until task complete              Cross-session persistent\nPermissions:         Inherited + restricted          Shared policy set               Strict least-privilege\nCommunication:       subagent() return value         transfer_to_agent() handoff     Filesystem signals\nBest for:            Decomposing complex tasks       Multi-persona workflows         Long-running autonomous work",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
