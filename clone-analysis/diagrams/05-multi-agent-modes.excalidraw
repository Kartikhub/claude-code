    {
      "type": "text",
      "id": "kairos_props_text",
      "x": 625,
      "y": 299.33343505859375,
      "width": 210.9375,
      "height": 75,
      "text": "Pattern: Background persistent\nTools: Restricted (read-only tools)\nPermissions: Least-privilege sandbox\nContext: Survives across sessions\n  via filesystem persistence\nState: Fully autonomous operation",
