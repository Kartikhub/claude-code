    {
      "type": "text",
      "id": "kairos_detail",
      "x": 55,
      "y": 138,
      "width": 295.3125,
      "height": 135,
      "text": "Background daemon that runs periodic tasks\nwhile user is idle.\n\nTriple Gate (ALL must pass):\n  1. User hasn't typed in >30s\n  2. No active tool execution\n  3. kairos_enabled flag = true\n\nUse cases: pre-fetch, indexing, warm cache",
      "originalText": "Background daemon that runs periodic tasks\nwhile user is idle.\n\nTriple Gate (ALL must pass):\n  1. User hasn't typed in >30s\n  2. No active tool execution\n  3. kairos_enabled flag = true\n\nUse cases: pre-fetch, indexing, warm cache",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
