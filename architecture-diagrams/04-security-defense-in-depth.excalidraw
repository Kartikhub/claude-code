    {
      "type": "text",
      "id": "parser_detail",
      "x": 52.75760997425439,
      "y": 608,
      "width": 373.8180930397725,
      "height": 121.45452325994313,
      "text": "Claude's parser vs Bash's parser see\ndifferent tokens for same input:\n\n  User input:  rm -rf /\\r\\necho \"safe\"\n  Claude sees: rm -rf / ; echo \"safe\"\n  Bash sees:   rm -rf /\n\nThe \\r (CR) creates a validator blind spot",
      "originalText": "Claude's parser vs Bash's parser see\ndifferent tokens for same input:\n\n  User input:  rm -rf /\\r\\necho \"safe\"\n  Claude sees: rm -rf / ; echo \"safe\"\n  Bash sees:   rm -rf /\n\nThe \\r (CR) creates a validator blind spot",
      "fontSize": 12.145452325994313,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
