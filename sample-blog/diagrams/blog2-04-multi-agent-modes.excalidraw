    {
      "type": "text",
      "id": "swarm_desc",
      "x": 518.0000305175781,
      "y": 225.33334350585938,
      "width": 210,
      "height": 100,
      "text": "Peer mesh topology\nAny peer can hand off to any other\nShared context via message passing\nNo hierarchy enforced\nOpenAI Swarm-inspired\nResult: flexible, emergent\nBest for: collaborative exploration",
