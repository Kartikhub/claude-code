    {
      "type": "text",
      "id": "kairos_desc",
      "x": 778.0000305175781,
      "y": 220.33334350585938,
      "width": 210,
      "height": 110,
      "text": "Background persistent agent\nSurvives after main exits\nOwn conversation loop + memory\nMonitors via heartbeat/lock files\nFile-system IPC, not sockets\nKAIROS = long-running watcher\nResult: ambient intelligence\nBest for: ongoing project tasks",
      "originalText": "Background persistent agent\nSurvives after main exits\nOwn conversation loop + memory\nMonitors via heartbeat/lock files\nFile-system IPC, not sockets\nKAIROS = long-running watcher\nResult: ambient intelligence\nBest for: ongoing project tasks",
      "fontSize": 9,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 3110,
      "version": 22,
      "versionNonce": 1856366534,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": [],
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25,
      "index": "aZ",
      "frameId": null,
