      "updated": 1775590495750,
      "autoResize": true
    },
    {
      "type": "text",
      "id": "insight",
      "x": 269.9531555175781,
      "y": 383,
      "width": 696.09375,
      "height": 41.25,
      "text": "Key insight: These aren't competing approaches. They solve different coordination problems.\nCoordinator = known decomposition. Swarm = unknown decomposition. KAIROS = work that outlives conversations.\nMost AI tools only implement one. Claude Code ships all three and picks per-task.",
      "originalText": "Key insight: These aren't competing approaches. They solve different coordination problems.\nCoordinator = known decomposition. Swarm = unknown decomposition. KAIROS = work that outlives conversations.\nMost AI tools only implement one. Claude Code ships all three and picks per-task.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "top",
      "strokeColor": "#6d28d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
