    {
      "type": "text",
      "id": "coord_desc",
      "x": 258.0000305175781,
      "y": 245.33334350585938,
      "width": 210,
      "height": 80,
      "text": "Hub-spoke topology\nMain dispatches, collects results\nSubs inherit permissions\nSubs cannot spawn children\nResult: structured, predictable\nBest for: parallel subtasks",
