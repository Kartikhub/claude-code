    {
      "type": "text",
      "id": "why_text",
      "x": 240.069091796875,
      "y": 376.6666564941406,
      "width": 625.1953125,
      "height": 41.25,
      "text": "Why four systems? Different knowledge has different half-lives.\nA preference survives forever. A debugging context dies with the session.\nMixing them in one system means permanent facts get flushed or temporary context never cleans up.",
      "originalText": "Why four systems? Different knowledge has different half-lives.\nA preference survives forever. A debugging context dies with the session.\nMixing them in one system means permanent facts get flushed or temporary context never cleans up.",
