    {
      "type": "text",
      "id": "sources_text",
      "x": 817.6668090820312,
      "y": 104,
      "width": 180,
      "height": 110,
      "text": "7 Rule Sources\n\n1. Global settings\n2. Project settings\n3. Workspace config\n4. Enterprise policies\n5. CLI flags\n6. Session overrides\n7. Runtime classifications\n\nDeny always beats Allow",
      "originalText": "7 Rule Sources\n\n1. Global settings\n2. Project settings\n3. Workspace config\n4. Enterprise policies\n5. CLI flags\n6. Session overrides\n7. Runtime classifications\n\nDeny always beats Allow",
      "fontSize": 10,
